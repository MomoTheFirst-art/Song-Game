# Firebase web config. NOT secret: these ship inside the client bundle by
# design, and access is controlled by security rules rather than by hiding
# them. They live here so the repo carries no project-specific values.
#
# Get them with:
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project song-game-719a2
#
# With these unset the game runs exactly as before, without accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
